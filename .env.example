# Local development only. `make env` generates a private .env with a random password.
COMPOSE_PROJECT_NAME=badi-esim
POSTGRES_USER=badi
POSTGRES_DB=badi
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=55432
TEST_POSTGRES_PORT=55433
API_PORT=8000
WEB_PORT=8080
BADI_ENVIRONMENT=development
BADI_MIGRATION_DATABASE_URL=postgresql+asyncpg://badi:change-me-local-only@127.0.0.1:55432/badi
BADI_APP_DB_PASSWORD=generate-app-db-password
BADI_DATABASE_URL=postgresql+asyncpg://badi_app:generate-app-db-password@127.0.0.1:55432/badi
# Dedicated disposable test service; never point integration tests at the app DB.
BADI_TEST_DATABASE_URL=postgresql+asyncpg://badi:badi-tests-only@127.0.0.1:55433/badi_test
BADI_AUTH_SECRET=generate-auth-secret
BADI_DEMO_PASSWORD=generate-demo-password
# Optional operations tuning.
BADI_LOG_LEVEL=INFO
BADI_WORKER_LAG_LOG_SECONDS=15
# Attachments: private storage dir, size cap (bytes), staged TTL (seconds), scan mode.
BADI_ATTACHMENT_DIR=var/attachments
BADI_ATTACHMENT_MAX_BYTES=10485760
BADI_ATTACHMENT_TTL_SECONDS=86400
BADI_ATTACHMENT_SCANNING=enabled
# Reply notifications: console logs a redacted line; disabled skips; smtp uses the host below.
BADI_EMAIL_BACKEND=console
BADI_EMAIL_FROM=support@example.test
BADI_SMTP_HOST=127.0.0.1
BADI_SMTP_PORT=1025
BADI_PUBLIC_BASE_URL=http://127.0.0.1:8080
